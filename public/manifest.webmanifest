{
  "name": "GlitchLens",
  "short_name": "GlitchLens",
  "description": "Self-hosted, multi-instance dashboard for GlitchTip",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0a0a0a",
  "theme_color": "#0a0a0a",

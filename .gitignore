# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ── Dependencies ──────────────────────────────────────────────
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.pnpm-store/

# ── Build output ──────────────────────────────────────────────
/.next/
/out/
/build
/dist
*.tsbuildinfo
next-env.d.ts

# ── Test & coverage ───────────────────────────────────────────
/coverage
/.nyc_output
/playwright-report
/test-results
/playwright/.cache

# ── Environment files ─────────────────────────────────────────
# Never commit local secrets, but keep the example template tracked.
.env
.env.*
!.env.example
!.env.development
!.env.test

# ── Logs & debug ──────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Editor / IDE ──────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.swp
*.swo
*~

# ── OS noise ──────────────────────────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ── Hosting / Deploy ──────────────────────────────────────────
.vercel
.netlify

# ── Local agent state ─────────────────────────────────────────
# Personal Claude / agent caches that shouldn't be shared.
.claude/
.cursor/
AGENTS.md

# ── Project-specific ──────────────────────────────────────────
# Personal preferences (sandbox URLs, test users) live in CLAUDE.local.md.
CLAUDE.local.md
*.local

# Secretos de deploy (infra sensible). deploy.sh y deploy.env.example sí se versionan.
deploy.env

# GlitchLens local data (SQLite database and encryption key)
/data/

# ── AI assistant and working files (not part of GlitchLens) ───
CLAUDE.md
CLAUDE.local.md
AGENTS.md
.claude/
tasks/
docs/plan_de_trabajo_*.md

# The project uses npm (package-lock.json); keep other package managers' files out
pnpm-lock.yaml
pnpm-workspace.yaml
yarn.lock

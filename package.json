{
  "name": "glitchlens",
  "version": "0.1.0",
  "description": "Self-hosted, multi-instance dashboard for GlitchTip with built-in users and a local database.",
  "author": {
    "name": "Eduardo Maldonado",
    "url": "https://www.emac.dev"
  },
  "license": "MIT",
  "keywords": [
    "glitchtip",
    "sentry",
    "error-tracking",
    "dashboard",
    "self-hosted",
    "nextjs",
    "multi-instance"
  ],
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:e2e": "node scripts/e2e/run.mjs",
    "reset-2fa": "node scripts/reset-2fa.mjs",
    "test:unit": "node --no-warnings --experimental-transform-types --import ./scripts/test/register.mjs --test \"tests/unit/**/*.test.ts\"",
    "test:coverage": "node --no-warnings --experimental-transform-types --import ./scripts/test/register.mjs --experimental-test-coverage --test-coverage-include=\"src/lib/**\" --test-coverage-include=\"src/proxy.ts\" --test \"tests/unit/**/*.test.ts\"",
    "test": "npm run test:unit && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@icons-pack/react-simple-icons": "^13.11.1",
    "@tailwindcss/postcss": "^4",
    "@tanstack/react-query": "^5.99.2",
    "@tanstack/react-query-devtools": "^5.99.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^1.8.0",
    "next": "^16.4.2",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "uqr": "0.1.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.2",
    "shadcn": "^4.4.0"
  }
}

# GlitchLens needs no configuration to run. Everything below is optional.

# Where the SQLite database and the encryption key live. Default: ./data
# GLITCHLENS_DATA_DIR=./data

# Encrypts GlitchTip tokens at rest (min. 32 chars). If unset, a random key is
# generated once and stored in <data dir>/secret.key. Keep it stable: changing it
# makes stored tokens unreadable and they must be entered again.
# GLITCHLENS_SECRET=

# Create the first superadmin at startup instead of using the /setup page.
# Password: 10-128 characters. Ignored once any user exists.
# GLITCHLENS_ADMIN_EMAIL=admin@example.com
# GLITCHLENS_ADMIN_PASSWORD=

# Fixed setup code for /setup (otherwise a random one is printed in the server log).
# GLITCHLENS_SETUP_CODE=

# Force the Secure flag on cookies ("true"/"false"). By default it follows the
# request: https or X-Forwarded-Proto: https.
# GLITCHLENS_COOKIE_SECURE=

# Set to "true" only when GlitchLens runs behind exactly one reverse proxy you control.
# It enables per-IP login throttling using the address that proxy appends to X-Forwarded-For.
# GLITCHLENS_TRUST_PROXY=false
